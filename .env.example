# Copy to .env (gitignored) and choose your own values.
POSTGRES_USER=terramind
POSTGRES_PASSWORD=
MINIO_ROOT_USER=terramind
MINIO_ROOT_PASSWORD=
NEO4J_PASSWORD=

# Point the code at the services (uncomment once `docker compose up -d` runs)
# TERRAMIND_DATABASE_URL=postgresql://terramind:<POSTGRES_PASSWORD>@127.0.0.1:5432/terramind
# TERRAMIND_NEO4J_URL=bolt://127.0.0.1:7687
# TERRAMIND_NEO4J_PASSWORD=<NEO4J_PASSWORD>
# TERRAMIND_S3_ENDPOINT=127.0.0.1:9000
# TERRAMIND_S3_ACCESS_KEY=terramind
# TERRAMIND_S3_SECRET_KEY=<MINIO_ROOT_PASSWORD>

# Optional overrides
# TERRAMIND_DATA=D:/terramind-data
